# Default: authorized Drive, otherwise data/claims.csv and data/evidence/.
# Set a CSV path only to force a specific local source (examples/claims.csv for demos).
CLAIMS_CSV_PATH=
CLAIMS_EVIDENCE_ROOT=

# Downloaded claims and PDFs under data/ (see README).
DOCKER_CLAIMS_CSV_PATH=
DOCKER_CLAIMS_EVIDENCE_ROOT=

# Optional, newly trained and verified research artifacts.
RECOMMENDATION_MODEL_PATH=
RECOMMENDATION_MODEL_SHA256=
RECOMMENDATION_EVALUATION_PATH=
RECOMMENDATION_EVALUATION_SHA256=

# Docker reads private host artifacts from cache/review/ at /models/.
DOCKER_RECOMMENDATION_MODEL_PATH=
DOCKER_RECOMMENDATION_MODEL_SHA256=
DOCKER_RECOMMENDATION_EVALUATION_PATH=
DOCKER_RECOMMENDATION_EVALUATION_SHA256=
